  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Controls\nMovement: WASD\r\nDash: Left Shift\nObjective\nSurvive as long
    as you can. \nTo attain Immortality.\r\n\r\nCollect rocks scattered throughout
    the rooms and\n bring them back to the glowing drop-off circle.\n Depositing
    rocks restores time and increases your total progress.\r\n\r\nCommon rocks restore
    a small amount of time.\r\nUncommon rocks restore more time.\r\nRare rocks restore
    the most time.\r\nYour timer pauses while you are inside the drop-off circle.\r\nUse
    the stairs to travel between floors, and avoid enemies and projectiles\nthey
    will knock you back and reduce your remaining time.\r\n\r\nDeposit 15 rocks to
    reach the final survival milestone, then keep \ncollecting time until the timer
    reaches 120 seconds.\r\n\r\nIf the timer reaches zero, the game is over. "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
